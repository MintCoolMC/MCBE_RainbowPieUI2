                    "source_property_name": "('\"' + '/party accept ' + #player_name + '\"')",
                    "target_property_name": "#item_name"
                  }
                ],
                "$fast_command_button_text": "Accept",
                "$fast_command_button_icon": "textures/ui/confirm"
              }
            },
            {
              "party_deny@rainbowpieui_chat.quick_command_button": {
