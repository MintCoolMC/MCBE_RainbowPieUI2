          "bindings": [
            {
              "binding_type": "view",
              "source_property_name": "(not (('\"' + #text - $message_invite_tr - $message_invite_ru - $message_invite_pt - $message_invite_nl - $message_invite_ko - $message_invite_ja - $message_invite_it - $message_invite_fr - $message_invite_es - $message_invite_en - $message_invite_de - $message_invite_cn + '\"') = #text))",
