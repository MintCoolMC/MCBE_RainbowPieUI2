                "$button_image_size": [ "100%", "100%" ],
                "anchor_from": "center",
                "anchor_to": "center",
                "size": [ "100%y", "100%" ],
                "$toggle_group_forced_index": 1000,
                "$toggle_view_binding_name": "show_search_box",
                "layer": 10,
                "bindings": [
                  {
                    "binding_type": "view",
                    "source_control_name": "show_search_box",
