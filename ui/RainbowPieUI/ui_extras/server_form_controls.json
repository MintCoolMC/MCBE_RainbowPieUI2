                        }
                      ],
                      "bindings": [
                        {
                          "binding_type": "view",
                          "source_control_name": "show_search_box",
                          "source_property_name": "#toggle_state",
                          "target_property_name": "#enabled"
                        }
                      ]
                    }
                  },
                  {
                    "search_text_box@common.text_edit_box": {
                      "$rainbowpie_localui_editbox_enabled": true,
