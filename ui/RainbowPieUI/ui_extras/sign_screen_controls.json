                        {
                          "from_button_id": "button.menu_cancel",
                          "to_button_id": "button.menu_exit",
                          "mapping_type": "global"
                        }
                      ]
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },

  "sign_background": {
    "type": "image",
    "texture": "$sign_texture",
