                    "target_property_name": "#slider_steps"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "#slider_value_init",
                    "target_property_name": "#slider_value"
                  }
                ]
              }
            },
            {
              "note_text@rainbowpie_ui_common.text_label": {
                "size": [ "default", 10 ],
                "text": "irl 6:00 = 0; irl 23:00 = 17000",
                "layer": 2
              }
            },
