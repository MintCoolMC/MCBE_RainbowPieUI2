                    "target_property_name": "#time_hour_int"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "((#time_hour_int < 6) * (18000 + 1000 * #time_hour_int) + (#time_hour_int > 6) * (#time_hour_int - 6) * 1000)",
                    "target_property_name": "#time_ingame_int"
                  },
                  {
                    "binding_type": "view",
                    "source_property_name": "('§§' + #time_ingame_int)",
