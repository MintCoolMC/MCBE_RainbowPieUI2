    "$rainbowpie_localui_info_value|default": "default value",
    "controls": [
      {
        "info_label": {
          "type": "stack_panel",
          "orientation": "horizontal",
          "size": [ "100%", "100%cm" ],
          "controls": [
            {
              "info_title_label@rainbowpie_ui_common.text_label": {
                "layer": 1,
                "size": [ "fill", "default" ],
                "text": "$rainbowpie_localui_info_title"
              }
